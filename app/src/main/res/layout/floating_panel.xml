<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:orientation="vertical"
    android:background="@drawable/panel_bg"
    android:padding="10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/panelIcon"
            android:src="@mipmap/ic_launcher"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="OpenCheps"/>

        <LinearLayout
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/panelTitle"
                android:text="OpenCheps"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/panelStatus"
                android:text="Starting…"
                android:textColor="#FFA5D6A7"
                android:textSize="11sp"
                android:maxWidth="190dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/panelRecal"
            android:background="@drawable/panel_btn_alt"
            android:src="@android:drawable/ic_menu_rotate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="Recalibrate"/>

        <ImageButton
            android:id="@+id/panelToggle"
            android:background="@drawable/panel_btn"
            android:src="@android:drawable/ic_media_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="Pause"/>

        <ImageButton
            android:id="@+id/panelStop"
            android:background="@drawable/panel_btn_stop"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Stop"/>
    </LinearLayout>

    <TextView
        android:id="@+id/panelEval"
        android:text=""
        android:textColor="#FFFFEB3B"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:paddingTop="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
